@model IEnumerable<MilkTeaShop.Models.Product>
@{
    ViewData["Title"] ??= "Menu đồ uống - Trà sữa, cà phê và trà trái cây";
    ViewData["Description"] ??= "Xem menu đồ uống MilkTeaShop gồm trà sữa, cà phê, trà trái cây và smoothie. Kiểm tra giá, tình trạng còn hàng và chọn món để đặt trực tuyến.";
    ViewData["CanonicalPath"] ??= "/menu";
    var heading = ViewData["Heading"]?.ToString() ?? "Menu đồ uống MilkTeaShop";
    var intro = ViewData["Intro"]?.ToString() ?? "Chọn đồ uống theo sở thích, xem giá gốc và tình trạng món trước khi đặt hàng.";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold fs-2 mb-3">@heading</h1>
        <p class="text-muted">@intro</p>
        <p><a href="/menu/tra-sua">Menu trà sữa</a> · <a href="/menu">Tất cả đồ uống</a> · <a href="/huong-dan/dat-hang">Hướng dẫn đặt hàng</a></p>
        <div class="mx-auto bg-success mt-2" style="height: 3px; width: 50px;"></div>
    </div>

    @if (!Model.Any())
    {
        <p class="alert alert-info">Danh mục đang cập nhật. Bạn có thể <a href="/menu">xem các đồ uống khác trong menu</a>.</p>
    }
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card">
                    @* Placeholder cho hình ảnh sản phẩm *@
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" class="img-fluid h-100 w-100 object-fit-cover" alt="@p.Name" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <i class="bi bi-cup-straw fs-1 text-muted opacity-50"></i>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                @(p.Category?.Name ?? "Đồ uống")
                            </span>
                        </div>

                        <h2 class="fw-bold fs-5 mb-2">@p.Name</h2>
                        <p class="text-muted small flex-grow-1">
                            @(p.Description ?? "Hương vị thơm ngon đặc trưng, được pha chế từ nguyên liệu tươi sạch.")
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <span class="fs-5 fw-bold text-success">@p.BasePrice.ToString("N0") đ</span>
                            @if (p.IsAvailable)
                            {
                                <a asp-controller="Order" asp-action="Create" asp-route-productId="@p.Id"
                                   class="btn btn-success rounded-pill px-4 fw-bold" aria-label="Đặt @p.Name">Đặt món</a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hết hàng</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.2s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .object-fit-cover {
        object-fit: cover;
    }
</style>